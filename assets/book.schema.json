{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyk-netizen/curiosity-site/assets/book.schema.json",
  "title": "好奇心工地 · 一本书",
  "description": "一本由孩子的问题生成的绘本。不管 agent 走生图、代码画图还是视频路线，都先产出这份 JSON，再按能力渲染。数量规则（章数、页数、旁白长度）由 scripts/validate_book.py 执行，见文末 x-rules。",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "mode",
    "language",
    "question",
    "guide",
    "render",
    "chapters",
    "child_page",
    "parent_card"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 30,
      "description": "书名，童趣、带点冒险感"
    },
    "mode": {
      "enum": [
        "new",
        "follow_up",
        "no_question"
      ],
      "description": "new=孩子的新问题；follow_up=孩子读完上一本后的追问；no_question=孩子今天没有问题，由 agent 从身边事物里出一题"
    },
    "continues_from": {
      "type": [
        "string",
        "null"
      ],
      "description": "mode=follow_up 时必填：上一本书的文件夹名或书名"
    },
    "language": {
      "enum": [
        "zh",
        "en",
        "bilingual"
      ]
    },
    "age_band": {
      "enum": [
        "small",
        "middle",
        "large"
      ],
      "description": "年龄档：small=小班 3–4 岁；middle=中班 4–5 岁；large=大班 5–6 岁。不填按 large 校验"
    },
    "question": {
      "type": "object",
      "required": [
        "original",
        "age"
      ],
      "additionalProperties": false,
      "properties": {
        "original": {
          "type": "string",
          "minLength": 1,
          "description": "孩子的原话，照录，不改写；no_question 模式下写 agent 替他出的题"
        },
        "age": {
          "type": "string",
          "minLength": 1,
          "description": "例如「5岁」「4岁8个月」"
        },
        "understood_as": {
          "type": "string",
          "description": "原话有口误或歧义时，agent 理解成什么"
        }
      }
    },
    "guide": {
      "type": "object",
      "description": "向导角色。来自家庭档案里的角色卡，原样回填，不许每本书重新发明",
      "required": [
        "name",
        "look",
        "colors",
        "catchphrase",
        "image_anchor"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "look": {
          "type": "string",
          "minLength": 1,
          "description": "中文外形描述"
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 6
        },
        "catchphrase": {
          "type": "string",
          "minLength": 1
        },
        "image_anchor": {
          "type": "string",
          "minLength": 1,
          "description": "英文外形锚句，每页 image_prompt 都必须原样包含"
        },
        "reference_image": {
          "type": [
            "string",
            "null"
          ],
          "description": "角色参考图的相对路径：生图路线用 .png，代码画图路线用角色 SVG"
        }
      }
    },
    "protagonist": {
      "type": [
        "object",
        "null"
      ],
      "description": "可选：孩子本人当主角（向导带着孩子本人去探险）。用孩子形象生成的卡通形象，不用真实照片；不写真名",
      "required": [
        "name",
        "look",
        "image_anchor",
        "consent"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "书里怎么称呼主角：小名、昵称或「你」，不写真名"
        },
        "look": {
          "type": "string",
          "minLength": 1,
          "description": "中文外形描述"
        },
        "image_anchor": {
          "type": "string",
          "minLength": 1,
          "description": "英文外形锚句；主角出现的页面，image_prompt 要原样包含"
        },
        "reference_image": {
          "type": [
            "string",
            "null"
          ],
          "description": "主角参考图（卡通形象）的相对路径"
        },
        "consent": {
          "enum": [
            "family_only",
            "public_ok"
          ],
          "description": "家长的分享授权：family_only=只在家里/发给家人；public_ok=家长明确同意可以公开（仍不写真名）"
        }
      }
    },
    "render": {
      "type": "object",
      "required": [
        "route"
      ],
      "additionalProperties": false,
      "properties": {
        "route": {
          "enum": [
            "image",
            "code",
            "video"
          ],
          "description": "image=能直接生图的 agent；code=用 SVG/Canvas 代码画；video=动画/视频"
        },
        "style": {
          "type": "string",
          "description": "画风，例如「水彩绘本」「积木画风」"
        },
        "agent": {
          "type": "string",
          "description": "实际跑这本书的 agent 和模型，例如「Codex · gpt-6.1-sol」"
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "pages",
          "follow_up"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "discover",
              "structure",
              "magic"
            ],
            "description": "建筑师拆解法三章：discover=发现与走进去；structure=结构与它怎么工作；magic=魔法时刻与回到生活"
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "narration",
                "visual"
              ],
              "additionalProperties": false,
              "properties": {
                "narration": {
                  "type": "string",
                  "minLength": 1,
                  "description": "旁白。中文不超过 60 字；英文不超过 40 词"
                },
                "narration_en": {
                  "type": "string",
                  "minLength": 1,
                  "description": "language=bilingual 时的英文旁白，不超过 40 词"
                },
                "visual": {
                  "type": "object",
                  "required": [
                    "description",
                    "image_prompt"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "description": "中文画面说明：画面里有什么、向导在做什么"
                    },
                    "image_prompt": {
                      "type": "string",
                      "minLength": 1,
                      "description": "英文生图指令，30–80 词，必须包含 guide.image_anchor"
                    },
                    "image": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "渲染好的画面文件（.png/.jpg/.svg）相对 book.json 的路径"
                    }
                  }
                }
              }
            }
          },
          "follow_up": {
            "type": "object",
            "required": [
              "question"
            ],
            "additionalProperties": false,
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "description": "孩子口吻的追问，例如「那冰箱里的水果为什么不坏？」"
              },
              "why": {
                "type": "string",
                "description": "给家长看：这个追问通向什么"
              }
            }
          }
        }
      }
    },
    "child_page": {
      "type": "object",
      "description": "最后一页留给孩子。Skill 从不替孩子写结局",
      "required": [
        "prompt",
        "child_words"
      ],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "例如「你还想知道什么？」"
        },
        "child_words": {
          "type": "string",
          "description": "孩子自己说的追问或结尾，原话照录；还没读时为空字符串"
        }
      }
    },
    "parent_card": {
      "type": "object",
      "description": "家长卡：给家长看，不给孩子看",
      "required": [
        "hard_notes",
        "sources",
        "uncertain",
        "sensitive",
        "weekend_project",
        "approval"
      ],
      "additionalProperties": false,
      "properties": {
        "hard_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 4,
          "description": "核心原理，2–3 句"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "title",
              "where"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "where": {
                "type": "string",
                "minLength": 1,
                "description": "网址、书名页码，或「模型自有知识，未联网核对」"
              },
              "used_for": {
                "type": "string"
              }
            }
          }
        },
        "uncertain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "拿不准、或为了讲给孩子而简化过头的地方。没有就写空数组，但 agent 要先认真想过"
        },
        "sensitive": {
          "type": "object",
          "required": [
            "level",
            "topics",
            "how_handled"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "none",
                "notice",
                "parent_first"
              ],
              "description": "none=无；notice=家长卡里提醒；parent_first=家长先看并放行后孩子才能看"
            },
            "topics": {
              "type": "array",
              "items": {
                "enum": [
                  "death",
                  "body",
                  "fear",
                  "religion",
                  "family_change",
                  "disaster",
                  "other"
                ]
              }
            },
            "how_handled": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "weekend_project": {
          "type": "string",
          "minLength": 1,
          "description": "一个在家能做的小实验或观察"
        },
        "approval": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "approved",
                "changes_requested"
              ]
            },
            "note": {
              "type": "string"
            },
            "date": {
              "type": "string"
            }
          }
        },
        "co_reading": {
          "type": "object",
          "description": "共读卡：家长陪孩子读时停下来问的地方。3–6 岁的书由大人读给孩子听，边读边聊比书本身更重要",
          "required": [
            "pauses",
            "tips"
          ],
          "additionalProperties": false,
          "properties": {
            "pauses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "page",
                  "ask"
                ],
                "additionalProperties": false,
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "正文第几页（从 1 数）"
                  },
                  "ask": {
                    "type": "string",
                    "minLength": 1,
                    "description": "家长停下来问的开放问题，例如「你猜它会去哪儿？」"
                  }
                }
              }
            },
            "tips": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "一两句共读提醒，例如「孩子插嘴就停下来听，不用读完」"
            }
          }
        }
      }
    }
  },
  "x-rules": {
    "说明": "JSON Schema 表达不了的规则，validate_book.py 必须逐条检查并报错",
    "chapters_by_mode": "mode=new 或 no_question：正好 3 章，role 依次为 discover / structure / magic；mode=follow_up：1–3 章",
    "total_pages": "mode=new 或 no_question：全书 4–8 页；mode=follow_up：2–8 页",
    "continues_from": "mode=follow_up 时 continues_from 必须是非空字符串",
    "narration_length": "语言长度上限见 age_band_limits；language=en 时不超过 40 个英文单词；narration_en 不超过 40 词",
    "image_prompt_words": "image_prompt 30–80 个英文单词",
    "guide_anchor": "每页 image_prompt 必须包含 guide.image_anchor 原文",
    "ip_blocklist": "全书任何字符串字段都不许出现 assets/ip_blocklist.txt 里的词（大小写不敏感）",
    "companion_phrases": "narration 不许出现 assets/companion_blocklist.txt 里的话（AI 不扮演孩子的朋友或陪伴者）",
    "sensitive_gate": "sensitive.level=parent_first 时 topics 不能为空",
    "image_files": "visual.image 非空时，文件必须存在（相对 book.json 所在目录）",
    "age_band_limits": "按 age_band 校验（不填按 large）：small 全书正文 3–4 页、每页中文旁白 ≤30 字；middle 4–6 页、≤45 字；large 4–8 页、≤60 字。mode=follow_up 时页数下限放宽到 2，上限不变",
    "co_reading_pages": "co_reading.pauses[].page 不能超过全书正文页数"
  }
}